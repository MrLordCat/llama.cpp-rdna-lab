  %uint_neg1 = OpConstant %uint 4294967295
  %float_448 = OpConstant %f32 448
      %fp8_0 = OpConstant %fp8 0
      %int_0 = OpConstant %int 0
      %int_1 = OpConstant %int 1
      %int_2 = OpConstant %int 2
      %int_3 = OpConstant %int 3
      %int_4 = OpConstant %int 4
      %int_6 = OpConstant %int 6
      %int_7 = OpConstant %int 7
     %float_0 = OpConstant %f32 0
 %float_half = OpConstant %f32 0.5
    %float_1 = OpConstant %f32 1
    %float_8 = OpConstant %f32 8
  %float_512 = OpConstant %f32 512
%float_1o64 = OpConstant %f32 0.015625
%float_negmax2 = OpConstant %f32 -1.7014118e38
   %half_0 = OpConstant %f16 0
   %half_1 = OpConstant %f16 1
%half_65504 = OpConstant %f16 65504
%half_neg65504 = OpConstant %f16 -65504
   %v4f32_0 = OpConstantComposite %v4f32 %float_0 %float_0 %float_0 %float_0
   %v4f16_0 = OpConstantComposite %v4f16 %half_0 %half_0 %half_0 %half_0
  %v4f16_min = OpConstantComposite %v4f16 %half_neg65504 %half_neg65504 %half_neg65504 %half_neg65504
  %v4f16_max = OpConstantComposite %v4f16 %half_65504 %half_65504 %half_65504 %half_65504
   %half_ninf = OpConstant %f16 64512
  %v4f16_ninf = OpConstantComposite %v4f16 %half_ninf %half_ninf %half_ninf %half_ninf
    %f32_ninf = OpConstant %f32 -0x1p128
  %v4f32_ninf = OpConstantComposite %v4f32 %f32_ninf %f32_ninf %f32_ninf %f32_ninf
   %cmz_f32 = OpConstantComposite %cm_f32 %float_0
   %cmz_f16 = OpConstantComposite %cm_f16c %half_0

; ===== spec constant declarations =====
       %sc_wg = OpSpecConstant %uint 256
       %sc_Br = OpSpecConstant %uint 16
       %sc_Bc = OpSpecConstant %uint 64
      %sc_HSK = OpSpecConstant %uint 256
      %sc_HSV = OpSpecConstant %uint 256
    %sc_Clamp = OpSpecConstant %uint 0
    %sc_Dsplit = OpSpecConstant %uint 8
   %sc_rsplit = OpSpecConstant %uint 4
     %sc_sgsz = OpSpecConstant %uint 64
  %sc_staging = OpSpecConstant %uint 0
    %sc_flags = OpSpecConstant %uint 0
  %sc_limocc = OpSpecConstant %uint 0
     %sc_fatk = OpSpecConstant %uint 1
     %sc_fatv = OpSpecConstant %uint 1
     %sc_blkk = OpSpecConstant %uint 1
     %sc_blkv = OpSpecConstant %uint 1

; ===== derived spec-constant ops =====
%hsk_pad = OpSpecConstantOp %uint BitwiseAnd %sc_HSK %uint_4294967280
%hsv_pad = OpSpecConstantOp %uint BitwiseAnd %sc_HSV %uint_4294967280
%tprg = OpSpecConstantOp %uint UDiv %sc_wg %sc_rsplit
%rpt = OpSpecConstantOp %uint UDiv %sc_Br %sc_rsplit
%hsk_div4 = OpSpecConstantOp %uint UDiv %sc_HSK %uint_4
%hsv_div4 = OpSpecConstantOp %uint UDiv %sc_HSV %uint_4
%dpt_t = OpSpecConstantOp %uint IAdd %hsv_div4 %tprg
%dpt_t2 = OpSpecConstantOp %uint ISub %dpt_t %uint_1
%dpt = OpSpecConstantOp %uint UDiv %dpt_t2 %tprg
%cpt = OpSpecConstantOp %uint UDiv %sc_Bc %tprg
%hsvpt = OpSpecConstantOp %uint IMul %uint_16 %sc_rsplit
%ntiles_t = OpSpecConstantOp %uint IAdd %sc_HSV %hsvpt
%ntiles_t2 = OpSpecConstantOp %uint ISub %ntiles_t %uint_1
%ntiles = OpSpecConstantOp %uint UDiv %ntiles_t2 %hsvpt
%qstride8 = OpSpecConstantOp %uint IAdd %hsk_pad %uint_8
%len_qf8 = OpSpecConstantOp %uint IMul %sc_Br %qstride8
%hsk_le128 = OpSpecConstantOp %bool ULessThanEqual %sc_HSK %uint_128
%Br_div4 = OpSpecConstantOp %uint UDiv %sc_Br %uint_4
%Br_div4_2 = OpSpecConstantOp %uint IAdd %Br_div4 %uint_2
%sfshstride = OpSpecConstantOp %uint Select %hsk_le128 %Br_div4_2 %Br_div4
%len_sfsh = OpSpecConstantOp %uint IMul %sc_Bc %sfshstride
%psh_stride = OpSpecConstantOp %uint IAdd %Br_div4 %uint_2
%len_psh = OpSpecConstantOp %uint IMul %sc_Bc %psh_stride
%kvsh_len = OpSpecConstantOp %uint IMul %uint_16 %sc_Bc
%kstg_len = OpSpecConstantOp %uint IMul %sc_Bc %uint_16
%osh_stride = OpSpecConstantOp %uint IMul %sc_rsplit %uint_4
%pvsh_len = OpSpecConstantOp %uint IMul %uint_16 %osh_stride
%hsktiles = OpSpecConstantOp %uint UDiv %hsk_pad %uint_16
%bcchunks = OpSpecConstantOp %uint UDiv %sc_Bc %uint_16
%vloads = OpSpecConstantOp %uint UDiv %uint_1024 %sc_wg

; ===== shmem array types =====
%arr_qf8sh = OpTypeArray %fp8 %len_qf8
%arr_sfsh = OpTypeArray %v4f32 %len_sfsh
%arr_psh = OpTypeArray %v4f16 %len_psh
%arr_kvsh = OpTypeArray %v4f16 %kvsh_len
%arr_kstg = OpTypeArray %fp8 %kstg_len
%arr_pvsh = OpTypeArray %v4f16 %pvsh_len
%arr_slope = OpTypeArray %f32 %sc_Br
%arr_tmp = OpTypeArray %f32 %sc_rsplit
%arr_lut = OpTypeArray %f16 %uint_256

; ===== runtime arrays =====
     %arr_qv4 = OpTypeRuntimeArray %v4f32
    %arr_kfp8 = OpTypeRuntimeArray %fp8
    %arr_vfp8 = OpTypeRuntimeArray %fp8
    %arr_mf16 = OpTypeRuntimeArray %f16
    %arr_sf32 = OpTypeRuntimeArray %f32
     %arr_ov4 = OpTypeRuntimeArray %v4f16
    %arr_of16 = OpTypeRuntimeArray %f16
     %arr_mou = OpTypeRuntimeArray %uint

; ===== buffer structs =====
        %s_q = OpTypeStruct %arr_qv4
        %s_k = OpTypeStruct %arr_kfp8
        %s_v = OpTypeStruct %arr_vfp8
        %s_m = OpTypeStruct %arr_mf16
        %s_s = OpTypeStruct %arr_sf32
       %s_o4 = OpTypeStruct %arr_ov4
       %s_o1 = OpTypeStruct %arr_of16
       %s_mo = OpTypeStruct %arr_mou
       %s_db = OpTypeStruct %arr_sf32

; ===== buffer pointers =====
      %p_q = OpTypePointer StorageBuffer %s_q
      %p_k = OpTypePointer StorageBuffer %s_k
      %p_v = OpTypePointer StorageBuffer %s_v
      %p_m = OpTypePointer StorageBuffer %s_m
      %p_s = OpTypePointer StorageBuffer %s_s
     %p_o4 = OpTypePointer StorageBuffer %s_o4
     %p_o1 = OpTypePointer StorageBuffer %s_o1
     %p_mo = OpTypePointer StorageBuffer %s_mo
     %p_db = OpTypePointer StorageBuffer %s_db
    %p_pc = OpTypePointer PushConstant %pc_t
%p_uint_pc = OpTypePointer PushConstant %uint
%p_v4f32_sb = OpTypePointer StorageBuffer %v4f32
%p_fp8_sb = OpTypePointer StorageBuffer %fp8
%p_f16_sb = OpTypePointer StorageBuffer %f16
%p_f32_sb = OpTypePointer StorageBuffer %f32
%p_v4f16_sb = OpTypePointer StorageBuffer %v4f16
%p_uint_sb = OpTypePointer StorageBuffer %uint

; ===== builtin pointers + variables =====
%_ptr_Input_v3u = OpTypePointer Input %v3u
%_ptr_Input_uint = OpTypePointer Input %uint
   %b_wgid = OpVariable %_ptr_Input_v3u Input
   %b_lidx = OpVariable %_ptr_Input_uint Input
  %b_wgsize = OpSpecConstantComposite %v3u %sc_wg %uint_1 %uint_1
   %b_sgid = OpVariable %_ptr_Input_uint Input
  %b_sginv = OpVariable %_ptr_Input_uint Input
  %b_numsg = OpVariable %_ptr_Input_uint Input

; ===== shmem pointers + variables =====
%p_sh_qf8 = OpTypePointer Workgroup %arr_qf8sh
%p_sh_sfsh = OpTypePointer Workgroup %arr_sfsh
%p_sh_psh = OpTypePointer Workgroup %arr_psh
%p_sh_kvsh = OpTypePointer Workgroup %arr_kvsh
%p_sh_kstg = OpTypePointer Workgroup %arr_kstg
%arr_qq = OpTypeArray %v4f16 %uint_1024
%p_sh_qq = OpTypePointer Workgroup %arr_qq
%arr_k16 = OpTypeArray %v4f16 %uint_1024
%p_sh_k16 = OpTypePointer Workgroup %arr_k16
%p_sh_pvsh = OpTypePointer Workgroup %arr_pvsh
%p_sh_slope = OpTypePointer Workgroup %arr_slope
%p_sh_tmp = OpTypePointer Workgroup %arr_tmp
%p_sh_lut = OpTypePointer Workgroup %arr_lut
%p_sh_fp8 = OpTypePointer Workgroup %fp8
%p_sh_v4f32 = OpTypePointer Workgroup %v4f32
%p_sh_v4f16 = OpTypePointer Workgroup %v4f16
%p_sh_f32 = OpTypePointer Workgroup %f32
%p_sh_f16 = OpTypePointer Workgroup %f16
    %sh_qf8 = OpVariable %p_sh_qf8 Workgroup
    %sh_sfsh = OpVariable %p_sh_sfsh Workgroup
     %sh_psh = OpVariable %p_sh_psh Workgroup
    %sh_kvsh = OpVariable %p_sh_kvsh Workgroup
    %sh_kstg = OpVariable %p_sh_kstg Workgroup
     %sh_qq = OpVariable %p_sh_qq Workgroup
     %sh_k16 = OpVariable %p_sh_k16 Workgroup
    %sh_pvsh = OpVariable %p_sh_pvsh Workgroup
    %sh_slope = OpVariable %p_sh_slope Workgroup
    %sh_tmp = OpVariable %p_sh_tmp Workgroup
     %sh_lut = OpVariable %p_sh_lut Workgroup

; ===== buffer variables =====
      %q_buf = OpVariable %p_q StorageBuffer
      %k_buf = OpVariable %p_k StorageBuffer
      %v_buf = OpVariable %p_v StorageBuffer
      %m_buf = OpVariable %p_m StorageBuffer
      %s_buf = OpVariable %p_s StorageBuffer
