; ===== function-local pointer types =====
%p_uint_f = OpTypePointer Function %uint
%p_f32_f = OpTypePointer Function %f32
%p_v4f16_f = OpTypePointer Function %v4f16
%p_cm_f32 = OpTypePointer Function %cm_f32
%p_cm_f16c = OpTypePointer Function %cm_f16c
