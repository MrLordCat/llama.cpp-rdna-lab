; D096-C: fp8-native flash attention prefill kernel (coopmat1 geometry).
; S-stage: K fp8 coopmat loads DIRECT from the KV cache (no f8->f16 dequant staging),
;          Q converted to fp8 once with tile scale s_q (S = K_f8 * Q_f8^T * s_q).
; V-stage: f16 coopmat (P f16 * V f16), V staged per-subgroup slices f8->f16 (LUT).
; Semantics ported from flash_attn_cm1.comp (GLSL) + flash_attn_base.glsl.
;
; Push constants: vk_flash_attn_push_constants - 32 x uint32 (128 B).
;   idx: 0 N, 1 KV, 2 ne1, 3 ne2, 4 ne3, 5 neq2, 6 neq3, 7 nek2, 8 nek3,
;        9 nev2, 10 nev3, 11 nem1, 12 nem2, 13 nem3, 14 nb01, 15 nb02, 16 nb03,
;        17 nb11, 18 nb12, 19 nb13, 20 nb21, 21 nb22, 22 nb23, 23 scale(f32),
;        24 max_bias(f32), 25 logit_softcap(f32), 26 mask_n_head_log2,
;        27 m0(f32), 28 m1(f32), 29 gqa_ratio, 30 split_kv, 31 k_num
; Spec constants: same IDs as flash_attn_base.glsl (0-15).

               OpCapability Shader
               OpCapability Float16
               OpCapability Float8EXT
               OpCapability Int8
               OpCapability CooperativeMatrixKHR
               OpCapability Float8CooperativeMatrixEXT
               OpCapability GroupNonUniform
               OpCapability GroupNonUniformVote
               OpCapability GroupNonUniformArithmetic
               OpCapability StorageBuffer16BitAccess
               OpCapability StorageBuffer8BitAccess
               OpCapability VulkanMemoryModel
               OpExtension "SPV_EXT_float8"
               OpExtension "SPV_KHR_cooperative_matrix"
          %glsl450 = OpExtInstImport "GLSL.std.450"
               OpMemoryModel Logical Vulkan
               OpEntryPoint GLCompute %main "main" %q_buf %k_buf %v_buf %m_buf %s_buf %o_buf4 %o_buf1 %mo_buf %dbg_buf %b_wgid %b_lidx %b_sgid %b_sginv %b_numsg %sh_qf8 %sh_qq %sh_sfsh %sh_psh %sh_kvsh %sh_kstg %sh_k16 %sh_pvsh %sh_slope %sh_tmp %sh_lut %pc
               OpExecutionModeId %main LocalSizeId %sc_wg %uint_1 %uint_1
               OpSource GLSL 450

; ===== spec constant IDs (flash_attn_base.glsl ABI) =====
               OpDecorate %sc_wg SpecId 0
               OpDecorate %sc_Br SpecId 1
               OpDecorate %sc_Bc SpecId 2
               OpDecorate %sc_HSK SpecId 3
               OpDecorate %sc_HSV SpecId 4
               OpDecorate %sc_Clamp SpecId 5
               OpDecorate %sc_Dsplit SpecId 6
               OpDecorate %sc_rsplit SpecId 7
               OpDecorate %sc_sgsz SpecId 8
               OpDecorate %sc_staging SpecId 9
               OpDecorate %sc_flags SpecId 10
               OpDecorate %sc_limocc SpecId 11
               OpDecorate %sc_fatk SpecId 12
               OpDecorate %sc_fatv SpecId 13
               OpDecorate %sc_blkk SpecId 14
               OpDecorate %sc_blkv SpecId 15

; ===== buffers =====
               OpDecorate %q_buf DescriptorSet 0
               OpDecorate %q_buf Binding 0
               OpDecorate %k_buf DescriptorSet 0
               OpDecorate %k_buf Binding 1
               OpDecorate %v_buf DescriptorSet 0
               OpDecorate %v_buf Binding 2
               OpDecorate %m_buf DescriptorSet 0
               OpDecorate %m_buf Binding 3
               OpDecorate %s_buf DescriptorSet 0
               OpDecorate %s_buf Binding 4
               OpDecorate %o_buf4 DescriptorSet 0
               OpDecorate %o_buf4 Binding 5
               OpDecorate %o_buf1 DescriptorSet 0
               OpDecorate %o_buf1 Binding 5
               OpDecorate %mo_buf DescriptorSet 0
               OpDecorate %mo_buf Binding 6
               OpDecorate %dbg_buf DescriptorSet 0
               OpDecorate %dbg_buf Binding 7

; ===== storage-buffer block layout =====
               OpDecorate %s_q Block
               OpMemberDecorate %s_q 0 NonWritable
               OpMemberDecorate %s_q 0 Offset 0
               OpDecorate %s_k Block
               OpMemberDecorate %s_k 0 NonWritable
               OpMemberDecorate %s_k 0 Offset 0
               OpDecorate %s_v Block
               OpMemberDecorate %s_v 0 NonWritable
               OpMemberDecorate %s_v 0 Offset 0
               OpDecorate %s_m Block
               OpMemberDecorate %s_m 0 NonWritable
               OpMemberDecorate %s_m 0 Offset 0
               OpDecorate %s_s Block
               OpMemberDecorate %s_s 0 NonWritable
               OpMemberDecorate %s_s 0 Offset 0
               OpDecorate %s_o4 Block
               OpMemberDecorate %s_o4 0 NonReadable
               OpMemberDecorate %s_o4 0 Offset 0
               OpDecorate %s_o1 Block
               OpMemberDecorate %s_o1 0 NonReadable
               OpMemberDecorate %s_o1 0 Offset 0
               OpDecorate %s_mo Block
               OpMemberDecorate %s_mo 0 NonWritable
               OpMemberDecorate %s_mo 0 Offset 0
               OpDecorate %s_db Block
               OpMemberDecorate %s_db 0 NonReadable
               OpMemberDecorate %s_db 0 Offset 0

; ===== push constants =====
               OpDecorate %pc_t Block
               OpMemberDecorate %pc_t 0 Offset 0
               OpMemberDecorate %pc_t 1 Offset 4
               OpMemberDecorate %pc_t 2 Offset 8
               OpMemberDecorate %pc_t 3 Offset 12
               OpMemberDecorate %pc_t 4 Offset 16
               OpMemberDecorate %pc_t 5 Offset 20
               OpMemberDecorate %pc_t 6 Offset 24
               OpMemberDecorate %pc_t 7 Offset 28
               OpMemberDecorate %pc_t 8 Offset 32
               OpMemberDecorate %pc_t 9 Offset 36
               OpMemberDecorate %pc_t 10 Offset 40
               OpMemberDecorate %pc_t 11 Offset 44
               OpMemberDecorate %pc_t 12 Offset 48
               OpMemberDecorate %pc_t 13 Offset 52
               OpMemberDecorate %pc_t 14 Offset 56
               OpMemberDecorate %pc_t 15 Offset 60
               OpMemberDecorate %pc_t 16 Offset 64
               OpMemberDecorate %pc_t 17 Offset 68
               OpMemberDecorate %pc_t 18 Offset 72
               OpMemberDecorate %pc_t 19 Offset 76
               OpMemberDecorate %pc_t 20 Offset 80
               OpMemberDecorate %pc_t 21 Offset 84
               OpMemberDecorate %pc_t 22 Offset 88
               OpMemberDecorate %pc_t 23 Offset 92
               OpMemberDecorate %pc_t 24 Offset 96
               OpMemberDecorate %pc_t 25 Offset 100
               OpMemberDecorate %pc_t 26 Offset 104
               OpMemberDecorate %pc_t 27 Offset 108
               OpMemberDecorate %pc_t 28 Offset 112
               OpMemberDecorate %pc_t 29 Offset 116
               OpMemberDecorate %pc_t 30 Offset 120
               OpMemberDecorate %pc_t 31 Offset 124

; ===== builtins =====
               OpDecorate %b_wgid BuiltIn WorkgroupId
               OpDecorate %b_lidx BuiltIn LocalInvocationIndex
               OpDecorate %b_sgid BuiltIn SubgroupId
               OpDecorate %b_sginv BuiltIn SubgroupLocalInvocationId
               OpDecorate %b_numsg BuiltIn NumSubgroups

; ===== array strides =====
               OpDecorate %arr_qv4 ArrayStride 16
               OpDecorate %arr_kfp8 ArrayStride 1
               OpDecorate %arr_vfp8 ArrayStride 1
               OpDecorate %arr_mf16 ArrayStride 2
               OpDecorate %arr_sf32 ArrayStride 4
               OpDecorate %arr_ov4 ArrayStride 8
               OpDecorate %arr_of16 ArrayStride 2
               OpDecorate %arr_mou ArrayStride 4

; ===== basic types =====
       %void = OpTypeVoid
         %fn = OpTypeFunction %void
       %bool = OpTypeBool
   %bool_true = OpConstantTrue %bool
   %bool_false = OpConstantFalse %bool
     %v4bool = OpTypeVector %bool 4
       %uint = OpTypeInt 32 0
        %int = OpTypeInt 32 1
      %uint8 = OpTypeInt 8 0
        %f32 = OpTypeFloat 32
        %f16 = OpTypeFloat 16
        %fp8 = OpTypeFloat 8 Float8E4M3EXT
        %v2f = OpTypeVector %f32 2
        %v3u = OpTypeVector %uint 3
      %v4f32 = OpTypeVector %f32 4
      %v4f16 = OpTypeVector %f16 4

; ===== pre-declared constants (required before coopmat types) =====
     %uint_0 = OpConstant %uint 0
     %uint_1 = OpConstant %uint 1
     %uint_2 = OpConstant %uint 2
     %uint_3 = OpConstant %uint 3
    %uint_16 = OpConstant %uint 16

; ===== cooperative matrix types (16x16, subgroup scope) =====
      %cm_f32 = OpTypeCooperativeMatrixKHR %f32 %uint_3 %uint_16 %uint_16 %uint_2
      %cm_f8a = OpTypeCooperativeMatrixKHR %fp8 %uint_3 %uint_16 %uint_16 %uint_0
      %cm_f8b = OpTypeCooperativeMatrixKHR %fp8 %uint_3 %uint_16 %uint_16 %uint_1
     %cm_f16a = OpTypeCooperativeMatrixKHR %f16 %uint_3 %uint_16 %uint_16 %uint_0
     %cm_f16b = OpTypeCooperativeMatrixKHR %f16 %uint_3 %uint_16 %uint_16 %uint_1
     %cm_f16c = OpTypeCooperativeMatrixKHR %f16 %uint_3 %uint_16 %uint_16 %uint_2

; ===== push constant struct (32 x uint32, 128 B) =====
        %pc_t = OpTypeStruct %uint %uint %uint %uint %uint %uint %uint %uint %uint %uint %uint %uint %uint %uint %uint %uint %uint %uint %uint %uint %uint %uint %uint %uint %uint %uint %uint %uint %uint %uint %uint %uint

; ===== constants =====
     %uint_4 = OpConstant %uint 4
     %uint_5 = OpConstant %uint 5
     %uint_6 = OpConstant %uint 6
