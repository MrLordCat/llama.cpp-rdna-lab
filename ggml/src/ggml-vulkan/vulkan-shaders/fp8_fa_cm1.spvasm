   %ma_v3 = OpLoad %f32 %ma_s3
   %ma_sl = OpCompositeConstruct %v4f32 %ma_v0 %ma_v1 %ma_v2 %ma_v3
   %ma_pr = OpFMul %v4f32 %ma_sl %ma_mf
   %ma_v2b = OpFAdd %v4f32 %ma_v %ma_pr
; masked positions -> -inf outright (S could be NaN from dirty fp8 cache rows)
   %ma_mn = OpFOrdEqual %v4bool %ma_mf %v4f32_ninf
   %ma_sel = OpSelect %v4f32 %ma_mn %v4f32_ninf %ma_v2b
               OpStore %ma_pp %ma_sel
               OpBranch %ma_done
   %ma_done = OpLabel
               OpControlBarrier %uint_2 %uint_2 %uint_264
; D096 v121: dump final S (post mask-add) for wg=0,0,0:
;   dbg[tid*4 + i] = sh_sfsh[col_tid*64 + row_tid][i]  (tid covers 16x16)
   %v121_x = OpIEqual %bool %wgx %uint_0
   %v121_z = OpIEqual %bool %wgz %uint_0
   %v121_w = OpIEqual %bool %wgy %uint_0
   %v121_xz = OpLogicalAnd %bool %v121_x %v121_z
   %v121_okw = OpLogicalAnd %bool %v121_xz %v121_w
; v128: also require the dump gate (pc bit 25) - only the armed call writes
   %v121_ok = OpLogicalAnd %bool %v121_okw %dbg_on
               OpSelectionMerge %v121_done None
               OpBranchConditional %v121_ok %v121_body %v121_done
   %v121_body = OpLabel
; v129: dump the S slot actually used by mask-add (us_c*sfshstride + us_r = tid).
; The old col_tid*64+row_tid indexing was from the pre-v115 layout and read
; wrong slots, which made the "S after mask" zone (dbg[0..1023]) misleading.
   %v121_o2 = OpCopyObject %uint %tid
   %v121_pp = OpAccessChain %p_sh_v4f32 %sh_sfsh %v121_o2
   %v121_v = OpLoad %v4f32 %v121_pp
   %v121_t4 = OpIMul %uint %tid %uint_4
   %v121_x0 = OpCompositeExtract %f32 %v121_v 0
   %v121_a0 = OpIAdd %uint %v121_t4 %uint_0
   %v121_p0 = OpAccessChain %p_f32_sb %dbg_buf %uint_0 %v121_a0
               OpStore %v121_p0 %v121_x0
   %v121_x1 = OpCompositeExtract %f32 %v121_v 1
   %v121_a1 = OpIAdd %uint %v121_t4 %uint_1
   %v121_p1 = OpAccessChain %p_f32_sb %dbg_buf %uint_0 %v121_a1
               OpStore %v121_p1 %v121_x1
   %v121_x2 = OpCompositeExtract %f32 %v121_v 2
   %v121_a2 = OpIAdd %uint %v121_t4 %uint_2
   %v121_p2 = OpAccessChain %p_f32_sb %dbg_buf %uint_0 %v121_a2
               OpStore %v121_p2 %v121_x2
   %v121_x3 = OpCompositeExtract %f32 %v121_v 3
   %v121_a3 = OpIAdd %uint %v121_t4 %uint_3
   %v121_p3 = OpAccessChain %p_f32_sb %dbg_buf %uint_0 %v121_a3
               OpStore %v121_p3 %v121_x3
; v123: dump the mask vector applied by mask-add (mc0_p) for ALL tids to dbg[1024 + tid*4 .. 1027]
   %v123_mv = OpLoad %v4f16 %mc0_p
   %v123_mf = OpFConvert %v4f32 %v123_mv
   %v123_m0 = OpCompositeExtract %f32 %v123_mf 0
   %v123_m1 = OpCompositeExtract %f32 %v123_mf 1
   %v123_m2 = OpCompositeExtract %f32 %v123_mf 2
   %v123_m3 = OpCompositeExtract %f32 %v123_mf 3
   %v123_t4 = OpIMul %uint %tid %uint_4
   %v123_ba = OpIAdd %uint %v123_t4 %uint_1024
   %v123_q0 = OpAccessChain %p_f32_sb %dbg_buf %uint_0 %v123_ba
               OpStore %v123_q0 %v123_m0
   %v123_q1 = OpAccessChain %p_f32_sb %dbg_buf %uint_0 %v123_ba
               OpStore %v123_q1 %v123_m1
   %v123_q2 = OpAccessChain %p_f32_sb %dbg_buf %uint_0 %v123_ba
               OpStore %v123_q2 %v123_m2
   %v123_q3 = OpAccessChain %p_f32_sb %dbg_buf %uint_0 %v123_ba
               OpStore %v123_q3 %v123_m3
               OpBranch %v121_done
   %v121_done = OpLabel
; ---------------- softmax ----------------
; kv_col = col_tid ; skip = kbc && (j*Bc + col_tid >= KV)
   %sm_kvc = OpIMul %uint %jv %sc_Bc
    %sm_kv = OpIAdd %uint %sm_kvc %col_tid
   %sm_ge = OpUGreaterThanEqual %bool %sm_kv %pKV
   %sm_sk = OpLogicalAnd %bool %kbc %sm_ge
   %sm_o = OpIMul %uint %col_tid %sfshstride
   %sm_o2 = OpIAdd %uint %sm_o %row_tid
   %sm_pp = OpAccessChain %p_sh_v4f32 %sh_sfsh %sm_o2
   %sm_v = OpLoad %v4f32 %sm_pp
   %sm_c0 = OpCompositeExtract %f32 %sm_v 0
   %sm_c1 = OpCompositeExtract %f32 %sm_v 1
   %sm_c2 = OpCompositeExtract %f32 %sm_v 2
   %sm_c3 = OpCompositeExtract %f32 %sm_v 3
; NaN guard in M reduction: dirty fp8 cache rows decode to NaN on the
; coopmat path; a NaN would poison the subgroupMax (M = NaN -> all P = NaN)
   %sm_n0 = OpFOrdEqual %bool %sm_c0 %sm_c0
   %sm_n1 = OpFOrdEqual %bool %sm_c1 %sm_c1
   %sm_n2 = OpFOrdEqual %bool %sm_c2 %sm_c2
   %sm_n3 = OpFOrdEqual %bool %sm_c3 %sm_c3
   %sm_i0 = OpLogicalNot %bool %sm_n0
   %sm_i1 = OpLogicalNot %bool %sm_n1
   %sm_i2 = OpLogicalNot %bool %sm_n2
   %sm_i3 = OpLogicalNot %bool %sm_n3
   %sm_m0 = OpLogicalOr %bool %sm_sk %sm_i0
   %sm_m1 = OpLogicalOr %bool %sm_sk %sm_i1
   %sm_m2 = OpLogicalOr %bool %sm_sk %sm_i2
   %sm_m3 = OpLogicalOr %bool %sm_sk %sm_i3
   %sm_s0 = OpSelect %f32 %sm_m0 %float_negmax2 %sm_c0
   %sm_s1 = OpSelect %f32 %sm_m1 %float_negmax2 %sm_c1
   %sm_s2 = OpSelect %f32 %sm_m2 %float_negmax2 %sm_c2
   %sm_s3 = OpSelect %f32 %sm_m3 %float_negmax2 %sm_c3
   %sm_sgx0 = OpGroupNonUniformFMax %f32 %uint_3 Reduce %sm_s0
   %sm_sgx1 = OpGroupNonUniformFMax %f32 %uint_3 Reduce %sm_s1
   %sm_sgx2 = OpGroupNonUniformFMax %f32 %uint_3 Reduce %sm_s2
   %sm_sgx3 = OpGroupNonUniformFMax %f32 %uint_3 Reduce %sm_s3
; r = 0

  %mold0 = OpLoad %f32 %mf0_p
   %mnew0 = OpExtInst %f32 %glsl450 FMax %sm_sgx0 %mold0
               OpStore %mf0_p %mnew0
   %em0_s = OpFSub %f32 %mold0 %mnew0
   %em0 = OpExtInst %f32 %glsl450 Exp %em0_s

   %lf0_v = OpLoad %f32 %lf0_p
   %lf0_n = OpFMul %f32 %em0 %lf0_v
               OpStore %lf0_p %lf0_n

   %of0_v = OpLoad %v4f16 %of0_p
   %em0h = OpFConvert %f16 %em0
   %of0_n = OpVectorTimesScalar %v4f16 %of0_v %em0h
               OpStore %of0_p %of0_n
; r = 1

  %mold1 = OpLoad %f32 %mf1_p
   %mnew1 = OpExtInst %f32 %glsl450 FMax %sm_sgx1 %mold1
               OpStore %mf1_p %mnew1
   %em1_s = OpFSub %f32 %mold1 %mnew1
   %em1 = OpExtInst %f32 %glsl450 Exp %em1_s

   %lf1_v = OpLoad %f32 %lf1_p
   %lf1_n = OpFMul %f32 %em1 %lf1_v
               OpStore %lf1_p %lf1_n

   %of1_v = OpLoad %v4f16 %of1_p
   %em1h = OpFConvert %f16 %em1
   %of1_n = OpVectorTimesScalar %v4f16 %of1_v %em1h
               OpStore %of1_p %of1_n
; r = 2

  %mold2 = OpLoad %f32 %mf2_p
   %mnew2 = OpExtInst %f32 %glsl450 FMax %sm_sgx2 %mold2
               OpStore %mf2_p %mnew2
   %em2_s = OpFSub %f32 %mold2 %mnew2
   %em2 = OpExtInst %f32 %glsl450 Exp %em2_s

   %lf2_v = OpLoad %f32 %lf2_p
   %lf2_n = OpFMul %f32 %em2 %lf2_v
               OpStore %lf2_p %lf2_n

   %of2_v = OpLoad %v4f16 %of2_p
   %em2h = OpFConvert %f16 %em2
   %of2_n = OpVectorTimesScalar %v4f16 %of2_v %em2h
               OpStore %of2_p %of2_n
; r = 3

  %mold3 = OpLoad %f32 %mf3_p
   %mnew3 = OpExtInst %f32 %glsl450 FMax %sm_sgx3 %mold3
               OpStore %mf3_p %mnew3
   %em3_s = OpFSub %f32 %mold3 %mnew3
   %em3 = OpExtInst %f32 %glsl450 Exp %em3_s

   %lf3_v = OpLoad %f32 %lf3_p
   %lf3_n = OpFMul %f32 %em3 %lf3_v
               OpStore %lf3_p %lf3_n

   %of3_v = OpLoad %v4f16 %of3_p
   %em3h = OpFConvert %f16 %em3
   %of3_n = OpVectorTimesScalar %v4f16 %of3_v %em3h
               OpStore %of3_p %of3_n
; P store: mfvec = (Mf[0..3]); Pf = f16(exp(S - mfvec)); Lf += Pf ; Psh[col*psh_stride + sg]
   %mfv0 = OpLoad %f32 %mf0_p
   %mfv1 = OpLoad %f32 %mf1_p
   %mfv2 = OpLoad %f32 %mf2_p
   %mfv3 = OpLoad %f32 %mf3_p
  %mfvec = OpCompositeConstruct %v4f32 %mfv0 %mfv1 %mfv2 %mfv3
   %p_o = OpIMul %uint %col_tid %psh_stride
   %p_o2 = OpIAdd %uint %p_o %row_tid
   %p_pp = OpAccessChain %p_sh_v4f16 %sh_psh %p_o2
               OpSelectionMerge %p_done None
               OpBranchConditional %sm_sk %p_zero %p_calc
   %p_zero = OpLabel
               OpStore %p_pp %v4f16_0
               OpBranch %p_done
   %p_calc = OpLabel
   %p_sv = OpLoad %v4f32 %sm_pp
; D096-F: guard NaN S (dirty fp8 rows) before exp: NaN would poison P/L/O
   %p_nx0 = OpCompositeExtract %f32 %p_sv 0
   %p_n0 = OpFOrdEqual %bool %p_nx0 %p_nx0
   %p_nx1 = OpCompositeExtract %f32 %p_sv 1
   %p_n1 = OpFOrdEqual %bool %p_nx1 %p_nx1
   %p_nx2 = OpCompositeExtract %f32 %p_sv 2
   %p_n2 = OpFOrdEqual %bool %p_nx2 %p_nx2
   %p_nx3 = OpCompositeExtract %f32 %p_sv 3
   %p_n3 = OpFOrdEqual %bool %p_nx3 %p_nx3
   %p_i0 = OpLogicalNot %bool %p_n0
   %p_i1 = OpLogicalNot %bool %p_n1
   %p_i2 = OpLogicalNot %bool %p_n2
   %p_i3 = OpLogicalNot %bool %p_n3
   %p_nv0 = OpSelect %f32 %p_i0 %float_negmax2 %p_nx0
   %p_nv1 = OpSelect %f32 %p_i1 %float_negmax2 %p_nx1
   %p_nv2 = OpSelect %f32 %p_i2 %float_negmax2 %p_nx2
   %p_nv3 = OpSelect %f32 %p_i3 %float_negmax2 %p_nx3
   %p_sv2 = OpCompositeConstruct %v4f32 %p_nv0 %p_nv1 %p_nv2 %p_nv3
   %p_sm = OpFSub %v4f32 %p_sv2 %mfvec
   %p_e = OpExtInst %v4f32 %glsl450 Exp %p_sm
   %p_pf = OpFConvert %v4f16 %p_e
; NaN guard: masked positions (mask == -inf) get P = 0 even if S is NaN
   %p_mv = OpLoad %v4f16 %mc0_p
   %p_mn = OpFOrdEqual %v4bool %p_mv %v4f16_ninf
   %p_pf2 = OpSelect %v4f16 %p_mn %v4f16_0 %p_pf
   %p_c0 = OpCompositeExtract %f16 %p_pf2 0
   %p_c1 = OpCompositeExtract %f16 %p_pf2 1
   %p_c2 = OpCompositeExtract %f16 %p_pf2 2
   %p_c3 = OpCompositeExtract %f16 %p_pf2 3
   %p_f0 = OpFConvert %f32 %p_c0
   %p_f1 = OpFConvert %f32 %p_c1
   %p_f2 = OpFConvert %f32 %p_c2
   %p_f3 = OpFConvert %f32 %p_c3
   %p_l0 = OpLoad %f32 %lf0_p
   %p_l0n = OpFAdd %f32 %p_l0 %p_f0
               OpStore %lf0_p %p_l0n
   %p_l1 = OpLoad %f32 %lf1_p
   %p_l1n = OpFAdd %f32 %p_l1 %p_f1
               OpStore %lf1_p %p_l1n
   %p_l2 = OpLoad %f32 %lf2_p
   %p_l2n = OpFAdd %f32 %p_l2 %p_f2
               OpStore %lf2_p %p_l2n
   %p_l3 = OpLoad %f32 %lf3_p
   %p_l3n = OpFAdd %f32 %p_l3 %p_f3
               OpStore %lf3_p %p_l3n
               OpStore %p_pp %p_pf2
               OpBranch %p_done
   %p_done = OpLabel
; D096 v131: the old v80 P-dump below is REMOVED - it unconditionally wrote
; dbg[0]=1 (breaking the S-after zone) and dbg[2048+wgy*2048+p_o2*4] (breaking
; the S-before zone) on EVERY dispatch, making v121/v124 reads meaningless.
; Its block is replaced by a direct branch to keep the merge label.
               OpBranch %pdbg_done
   %pdbg_done = OpLabel
; ---------------- V-stage ----------------
               OpStore %var_ht %uint_0
               OpBranch %ht_loop
   %ht_loop = OpLabel
    %htv = OpLoad %uint %var_ht
   %htok = OpULessThan %bool %htv %ntiles
               OpLoopMerge %ht_done %ht_inc None
               OpBranchConditional %htok %ht_body %ht_done
   %ht_body = OpLabel
               OpStore %var_vi %uint_0
               OpBranch %vs_loop
   %vs_loop = OpLabel
    %viv = OpLoad %uint %var_vi
   %viok = OpULessThan %bool %viv %vloads
               OpLoopMerge %vs_done %vs_inc None
               OpBranchConditional %viok %vs_body %vs_done
   %vs_body = OpLabel
   %vs_i2 = OpIMul %uint %viv %sc_wg
   %vs_i3 = OpIAdd %uint %vs_i2 %tid
   %vs_r = OpUDiv %uint %vs_i3 %uint_16
   %vs_c = OpUMod %uint %vs_i3 %uint_16
   %vs_jc = OpIMul %uint %jv %sc_Bc
   %vs_vr = OpIAdd %uint %vs_jc %vs_r
   %vs_kv = OpULessThan %bool %vs_vr %pKV
   %vs_h64 = OpIMul %uint %htv %uint_64
   %vs_c4 = OpIMul %uint %vs_c %uint_4
   %vs_vc = OpIAdd %uint %vs_h64 %vs_c4
   %vs_hsv = OpULessThan %bool %vs_vc %sc_HSV
   %vs_ok = OpLogicalAnd %bool %vs_kv %vs_hsv
; v109: always zero-fill invalid rows/cols (kbc staging diagnostic removed)
   %vs_fn = OpCopyObject %bool %vs_ok
               OpSelectionMerge %vs_cd None
               OpBranchConditional %vs_fn %vs_ld %vs_z
   %vs_ld = OpLabel
   %vs_ks = OpLoad %uint %var_vstride
   %vs_of = OpIMul %uint %vs_vr %vs_ks
   %vs_ad = OpIAdd %uint %vs_of %vs_vc
   %vs_ko = OpLoad %uint %var_voff
   %vs_ad2 = OpIAdd %uint %vs_ko %vs_ad
   %vs_b0 = OpAccessChain %p_fp8_sb %v_buf %uint_0 %vs_ad2
   %vs_w0 = OpLoad %fp8 %vs_b0
   %vs_u0 = OpBitcast %uint8 %vs_w0
   %vs_ui0 = OpUConvert %uint %vs_u0
   %vs_lp0 = OpAccessChain %p_sh_f16 %sh_lut %vs_ui0
   %vs_h0 = OpLoad %f16 %vs_lp0
   %vs_ad3 = OpIAdd %uint %vs_ad2 %uint_1
   %vs_b1 = OpAccessChain %p_fp8_sb %v_buf %uint_0 %vs_ad3
   %vs_w1 = OpLoad %fp8 %vs_b1
   %vs_u1 = OpBitcast %uint8 %vs_w1
   %vs_ui1 = OpUConvert %uint %vs_u1
   %vs_lp1 = OpAccessChain %p_sh_f16 %sh_lut %vs_ui1
   %vs_h1 = OpLoad %f16 %vs_lp1
   %vs_ad4 = OpIAdd %uint %vs_ad2 %uint_2
   %vs_b2 = OpAccessChain %p_fp8_sb %v_buf %uint_0 %vs_ad4
   %vs_w2 = OpLoad %fp8 %vs_b2
   %vs_u2 = OpBitcast %uint8 %vs_w2
   %vs_ui2 = OpUConvert %uint %vs_u2
   %vs_lp2 = OpAccessChain %p_sh_f16 %sh_lut %vs_ui2
   %vs_h2 = OpLoad %f16 %vs_lp2
   %vs_ad5 = OpIAdd %uint %vs_ad2 %uint_3
   %vs_b3 = OpAccessChain %p_fp8_sb %v_buf %uint_0 %vs_ad5
   %vs_w3 = OpLoad %fp8 %vs_b3
   %vs_u3 = OpBitcast %uint8 %vs_w3
   %vs_ui3 = OpUConvert %uint %vs_u3
   %vs_lp3 = OpAccessChain %p_sh_f16 %sh_lut %vs_ui3
   %vs_h3 = OpLoad %f16 %vs_lp3
  %vs_h4 = OpCompositeConstruct %v4f16 %vs_h0 %vs_h1 %vs_h2 %vs_h3
               OpBranch %vs_cd
   %vs_z = OpLabel
               OpBranch %vs_cd
   %vs_cd = OpLabel
   %vs_h5 = OpPhi %v4f16 %vs_h4 %vs_ld %v4f16_0 %vs_z
; D096 v109: correct kvsh layout for stride-16 coopmat loads.
; Slot = (vs_r>>4)*256 + htv*64 + (vs_r%16)*4 + vs_c/4 ; v4 components = d cols (vs_c*4+k).
; Load base = bcv*256 + htv*64 + sg*16 (sg rows), stride 16 -> element (r,c) at slot r*4+c/4.
   %vs_rs4 = OpUDiv %uint %vs_r %uint_16
   %vs_z256 = OpIMul %uint %vs_rs4 %uint_256
   %vs_ht64 = OpIMul %uint %htv %uint_64
   %vs_rm16 = OpUMod %uint %vs_r %uint_16
   %vs_rm4 = OpIMul %uint %vs_rm16 %uint_4
   %vs_cd4 = OpUDiv %uint %vs_c %uint_4
   %vs_k1 = OpIAdd %uint %vs_z256 %vs_ht64
   %vs_k2 = OpIAdd %uint %vs_k1 %vs_rm4
   %vs_ki = OpIAdd %uint %vs_k2 %vs_cd4
   %vs_kp = OpAccessChain %p_sh_v4f16 %sh_kvsh %vs_ki
               OpStore %vs_kp %vs_h5
               OpBranch %vs_inc
   %vs_inc = OpLabel
   %vs_iv = OpIAdd %uint %viv %uint_1
               OpStore %var_vi %vs_iv
               OpBranch %vs_loop
   %vs_done = OpLabel
               OpControlBarrier %uint_2 %uint_2 %uint_264
; PV accumulation over bc_chunk
               OpStore %var_pv %cmz_f16
               OpStore %var_bc %uint_0
               OpBranch %bc_loop
   %bc_loop = OpLabel
    %bcv = OpLoad %uint %var_bc
   %bcok = OpULessThan %bool %bcv %bcchunks
               OpLoopMerge %bc_done %bc_inc None
               OpBranchConditional %bcok %bc_body %bc_done
   %bc_body = OpLabel
   %bc_b1 = OpIMul %uint %bcv %uint_16
   %bc_b2 = OpIMul %uint %bc_b1 %psh_stride
   %bc_pp = OpAccessChain %p_sh_v4f16 %sh_psh %bc_b2
   %bc_k = OpCooperativeMatrixLoadKHR %cm_f16a %bc_pp %int_1 %psh_stride MakePointerVisible|NonPrivatePointer %uint_2
   %bc_q1 = OpIMul %uint %bcv %uint_256
; v109: V tile = (bc zone, htv subtile, sg rows). htv is the outer d-tile.
   %bc_ht = OpLoad %uint %var_ht
   %bc_qh = OpIMul %uint %bc_ht %uint_64
   %bc_q1b = OpIAdd %uint %bc_q1 %bc_qh
   %bc_q2 = OpIMul %uint %sg %uint_16
   %bc_q = OpIAdd %uint %bc_q1b %bc_q2
   %bc_qp = OpAccessChain %p_sh_v4f16 %sh_kvsh %bc_q
   %bc_qm = OpCooperativeMatrixLoadKHR %cm_f16b %bc_qp %int_0 %uint_16 MakePointerVisible|NonPrivatePointer %uint_2
   %bc_pv = OpLoad %cm_f16c %var_pv
   %bc_pvn = OpCooperativeMatrixMulAddKHR %cm_f16c %bc_k %bc_qm %bc_pv
               OpStore %var_pv %bc_pvn
               OpBranch %bc_inc
   %bc_inc = OpLabel
   %bc_iv = OpIAdd %uint %bcv %uint_1
               OpStore %var_bc %bc_iv
               OpBranch %bc_loop
   %bc_done = OpLabel
; store PV -> pvsh ; O-accumulate
   %pv_sg = OpIMul %uint %sg %uint_4
   %pv_pp = OpAccessChain %p_sh_v4f16 %sh_pvsh %pv_sg
   %pv_v = OpLoad %cm_f16c %var_pv
               OpCooperativeMatrixStoreKHR %pv_pp %pv_v %int_0 %osh_stride MakePointerAvailable|NonPrivatePointer %uint_2
; barrier between PV store and O-accumulate (cross-subgroup pvsh visibility)
               OpControlBarrier %uint_2 %uint_2 %uint_264
   %oa_c4 = OpIMul %uint %col_tid %uint_4
   %oa_h64 = OpIMul %uint %htv %uint_64
   %oa_h64p = OpIAdd %uint %oa_h64 %uint_64
   %oa_ge = OpUGreaterThanEqual %bool %oa_c4 %oa_h64
   %oa_lt = OpULessThan %bool %oa_c4 %oa_h64p
   %oa_r1 = OpLogicalAnd %bool %oa_ge %oa_lt
   %oa_hsv = OpULessThan %bool %oa_c4 %sc_HSV
   %oa_ok = OpLogicalAnd %bool %oa_r1 %oa_hsv
               OpSelectionMerge %oa_done None
               OpBranchConditional %oa_ok %oa_body %oa_done
   %oa_body = OpLabel
   %oa_lh = OpISub %uint %oa_c4 %oa_h64
   %oa_l4 = OpUDiv %uint %oa_lh %uint_4
   %oa_r0 = OpIAdd %uint %p_row_us %uint_0
   %oa_r16 = OpIMul %uint %oa_r0 %uint_16
   %oa_i = OpIAdd %uint %oa_r16 %oa_l4
   %oa_pp = OpAccessChain %p_sh_v4f16 %sh_pvsh %oa_i
   %oa_v = OpLoad %v4f16 %oa_pp
   %oa_o0 = OpLoad %v4f16 %of0_p
   %oa_o0n = OpFAdd %v4f16 %oa_o0 %oa_v
               OpStore %of0_p %oa_o0n
   %oa_r1b = OpIAdd %uint %p_row_us %uint_1
   %oa_r16b = OpIMul %uint %oa_r1b %uint_16
   %oa_ib = OpIAdd %uint %oa_r16b %oa_l4
   %oa_ppb = OpAccessChain %p_sh_v4f16 %sh_pvsh %oa_ib
