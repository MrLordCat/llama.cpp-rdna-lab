   %var_qoff = OpVariable %p_uint_f Function
   %var_sq = OpVariable %p_f32_f Function
   %var_invsq = OpVariable %p_f32_f Function
   %qmax_l = OpVariable %p_f32_f Function
   %q_idx = OpVariable %p_uint_f Function
   %q1_red = OpVariable %p_f32_f Function
   %q1_s = OpVariable %p_uint_f Function
