#version 450

#include "dequant_head.glsl"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly buffer A {block_f8_e4m3 data_a[];};
layout (binding = 1) writeonly buffer D {D_TYPE data_b[];};

// D095-D3: f8_e4m3 -> f16 dequant pass used by the FA preconvert path
// (mirrors dequant_q8_0: 4096 elements per workgroup, 16 per thread).
void main() {
    const uint i0 = gl_WorkGroupID.x * 4096 + gl_LocalInvocationID.x * 16;
    const uint i1 = min(i0 + 16, p.nel);
    for (uint i = i0; i < i1; i++) {
        data_b[i] = D_TYPE(fp8_e4m3_to_f32(data_a[i].v));
    }
}
