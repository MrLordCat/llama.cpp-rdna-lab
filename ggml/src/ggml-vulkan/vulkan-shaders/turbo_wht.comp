#version 450

#include "generic_unary_head.glsl"

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

shared float values[128];

int turbo_wht_sign(uint i) {
    uint x = i * 0x9E3779B9u + 0x85EBCA6Bu;
    x ^= x >> 16;
    x *= 0x7FEB352Du;
    x ^= x >> 15;
    x *= 0x846CA68Bu;
    x ^= x >> 16;
    return (x & 1u) != 0 ? 1 : -1;
}

void main() {
    const uint tid = gl_LocalInvocationID.x;
    const uint group = gl_WorkGroupID.x;
    const uint i1 = gl_WorkGroupID.y;
    const uint i2 = gl_WorkGroupID.z % p.ne02;
    const uint i3 = gl_WorkGroupID.z / p.ne02;
    const uint i0 = group * 128 + tid;
    const bool inverse = p.param1 != 0.0f;

    const uint src = get_aoffset() + i3 * p.nb03 + i2 * p.nb02 + i1 * p.nb01 + i0 * p.nb00;
    float value = data_a[src];
    values[tid] = inverse ? value : value * float(turbo_wht_sign(tid));
    barrier();

    [[unroll]] for (uint step = 1; step < 128; step <<= 1) {
        const float current = values[tid];
        const float peer = values[tid ^ step];
        barrier();
        values[tid] = (tid & step) == 0 ? current + peer : peer - current;
        barrier();
    }

    value = values[tid] * 0.08838834764831845f;
    if (inverse) {
        value *= float(turbo_wht_sign(tid));
    }

    const uint dst = get_doffset() + i3 * p.nb13 + i2 * p.nb12 + i1 * p.nb11 + i0 * p.nb10;
    data_d[dst] = value;
}