# Keep source and documentation line endings deterministic on every host.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
build_logs/agent-workload/*.csv text eol=crlf
build_logs/agent-workload/*.md text eol=crlf

# Treat the generated single-file WebUI build as binary for diff purposes.
# Git's pack-file delta compression still works (byte-level), but this prevents
# git diff from printing the entire minified file on every change.
tools/server/public/index.html -diff

# При merge из upstream: всегда сохранять нашу версию этих файлов
AGENTS.md merge=ours
AGENT_WORKFLOW.md merge=ours
CLAUDE.md merge=ours
README.md merge=ours
MTP.md merge=ours
MTP_IMPLEMENTATION_PLAN.md merge=ours
PROJECT_PROFILE.md merge=ours
QWEN_SPEED_RESEARCH.md merge=ours
BENCHMARKS.md merge=ours
UPSTREAM_SYNC.md merge=ours
gui/README.md merge=ours
gui/QUICKSTART.md merge=ours

# Этот форк не импортирует upstream automation/docs/instructions автоматически.
.github/** merge=ours
docs/** merge=ours
.gemini/** merge=ours
.devops/** merge=ours
